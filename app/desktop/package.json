{
  "name": "juice-desktop",
  "productName": "Juice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Juice for Windows and Linux: Bluetooth device batteries in the system tray",
  "author": {
    "name": "leechoonguk",
    "email": "leechoonguk@users.noreply.github.com"
  },
  "homepage": "https://github.com/leechoonguk/juice",
  "main": "out/main.cjs",
  "desktopName": "juice.desktop",
  "devDependencies": {
    "dbus-next": "0.10.2",
    "electron": "43.7.7",
    "electron-builder": "26.17.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native-web": "0.21.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "build": {
    "appId": "com.uk.juice",
    "productName": "Juice",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "icon": "out/icon.png",
    "artifactName": "Juice-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "leechoonguk",
      "repo": "juice",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Juice-${version}-windows-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "leechoonguk <leechoonguk@users.noreply.github.com>",
      "synopsis": "Bluetooth device batteries in the system tray",
      "executableName": "juice",
      "syncDesktopName": true
    }
  }
}
