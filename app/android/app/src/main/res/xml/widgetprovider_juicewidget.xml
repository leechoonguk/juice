<?xml version="1.0" encoding="utf-8"?>
<!-- The macOS widget's three sizes: 2×2 cells draw it small, 4×2 medium (placed by
     default), 4×4 large — app/mobile/src/widgetArt.ts picks one from the size the
     launcher gives. The preview is the widget's own drawing of the macOS sample
     (`make android-widget-preview`). Besides the app's reads, the system updates the
     widget every 30 minutes (its minimum), so the headless task re-reads and sends
     low-battery alerts after the app process is gone. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:initialLayout="@layout/rn_widget"
    android:previewImage="@drawable/widget_preview"
    android:description="@string/widget_description"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
